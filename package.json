{
  "name": "su-card-to-video",
  "version": "0.2.0",
  "private": true,
  "description": "A JSON-driven multistyle HTML/CSS card-to-video skill using HyperFrames, GSAP, and FFmpeg.",
  "scripts": {
    "doctor": "bash scripts/check-env.sh",
    "validate": "node scripts/validate-video-spec.mjs data/demo-video.json",
    "build": "node scripts/build-video-html.mjs",
    "render": "bash scripts/render.sh",
    "styles": "node scripts/build-video-html.mjs --list-styles"
  },
  "devDependencies": {
    "hyperframes": "latest"
  }
}
